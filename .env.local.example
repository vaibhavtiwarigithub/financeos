# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://mbnjblsqqnhgfrrpzefy.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key

# Anthropic - server-side only, NEVER prefix with NEXT_PUBLIC_
ANTHROPIC_API_KEY=your_new_api_key_after_rotating

# Stripe (for subscriptions)
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...

# Stripe Price IDs (create these in Stripe dashboard)
STRIPE_PRO_PRICE_ID=price_...
STRIPE_ELITE_PRICE_ID=price_...

# App
NEXT_PUBLIC_APP_URL=https://your-domain.com
ADMIN_EMAIL=vterminater@gmail.com

# HUD FMR / SAFMR (optional, server-side only)
# Free HUD User account token. Never expose it as NEXT_PUBLIC_ or place it in browser code.
HUD_FMR_API_TOKEN=

# USPS Address Standardization (optional, server-side only)
# Free developer account at https://developers.usps.com — create an app and
# enable the Addresses API. Without both values, property address verification
# is inert: the UI says "address verification is not configured" and no address
# is ever shown as verified. US only; India addresses have no wired validator.
USPS_CONSUMER_KEY=
USPS_CONSUMER_SECRET=

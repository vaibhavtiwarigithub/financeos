{
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "crons": [
    {
      "path": "/api/agents/evaluation/p1-gate/cron",
      "schedule": "0 2 * * 0"
    },
    {
      "path": "/api/agents/db-cleanup",
      "schedule": "0 3 1 * *"
    },
    {
      "path": "/api/agents/autonomous-shadow/cron",
      "schedule": "30 7 * * 1-5"
    }
  ]
}

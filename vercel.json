{
  "buildCommand": "next build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "installCommand": "npm install",
  "regions": ["iad1"],
  "functions": {
    "api/py/*.py": {
      "memory": 1024,
      "maxDuration": 30,
      "excludeFiles": "{.next,node_modules,app,components,lib,tests,docs,features,knowledge,public,supabase,scripts,types,backups}/**"
    }
  },
  "crons": [
    {
      "path": "/api/agents/evaluation/p1-gate/cron",
      "schedule": "0 2 * * 0"
    },
    {
      "path": "/api/agents/db-cleanup",
      "schedule": "0 3 1 * *"
    },
    {
      "path": "/api/agents/autonomous-live/cron?market=us",
      "schedule": "0 15 * * 1-5"
    },
    {
      "path": "/api/agents/autonomous-live/cron?market=india",
      "schedule": "0 6 * * 1-5"
    }
  ]
}
